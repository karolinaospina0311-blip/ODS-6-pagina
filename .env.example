# EcoAgua · Variables de entorno
# Copie este archivo como .env (desarrollo) o configure estas variables en Render.
# NO escriba aquí valores reales: este archivo se sube a GitHub.

# Clave para firmar las sesiones. Genérela con:
#   python -c "import secrets; print(secrets.token_hex(32))"
ECOAGUA_SECRET_KEY=

# Base de datos. Vacío = SQLite local en instance/ecoagua.db
# PostgreSQL (Render): postgresql://USUARIO:CLAVE@SERVIDOR:5432/NOMBRE_BD
DATABASE_URL=

# Usuarios de prueba que crea el comando "sembrar" al arrancar (si no existen)
ECOAGUA_ADMIN_USUARIO=
ECOAGUA_ADMIN_PASSWORD=
ECOAGUA_OPERADOR_USUARIO=
ECOAGUA_OPERADOR_PASSWORD=

# 1 = crea 30 reportes de ejemplo si la base está vacía
ECOAGUA_DATOS_EJEMPLO=

# Centro inicial de los mapas (por ejemplo Montería: 8.7575 / -75.8851 / 13)
ECOAGUA_MAPA_LAT=
ECOAGUA_MAPA_LNG=
ECOAGUA_MAPA_ZOOM=

# Fotografías
ECOAGUA_MAX_FOTO_MB=
ECOAGUA_FOTO_OBLIGATORIA=

# Producción detrás de HTTPS (Render): poner 1 en ambas
ECOAGUA_PROXY=
ECOAGUA_COOKIE_SEGURA=

# Zona horaria para mostrar fechas (por defecto America/Bogota)
ECOAGUA_ZONA_HORARIA=
